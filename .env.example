# Base PostgreSQL independiente para producción.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-unico"
# Token de json.pe. Nunca usar NEXT_PUBLIC_ ni exponerlo en el navegador.
JSONPE_API_TOKEN="pega-tu-token-aqui"
# Registros ATK valida directamente los usuarios y contraseñas de Turnos ATK.
REGISTROS_ATK_URL="https://registros-app-pi.vercel.app"
# Requerido para sincronizar la lista de usuarios desde Registros ATK.
REGISTROS_ATK_SHARED_SECRET="configura-el-mismo-secreto-en-ambos-proyectos"
# Voz de anuncios en la pantalla pública. La API key debe mantenerse solo en el servidor.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
# Pancake Pages inbox: keep the page token server-side, never expose it with NEXT_PUBLIC_.
PANCAKE_PAGE_ID=""
PANCAKE_PAGE_ACCESS_TOKEN=""
