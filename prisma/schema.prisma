generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  RECEPTION
  WORKER
}

enum TicketStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkerAvailability {
  AVAILABLE
  PAUSED
}

model Branch {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  code      String     @unique
  address   String?
  active    Boolean    @default(true)
  users     User[]
  tickets   Ticket[]
  largeRoom LargeRoom?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Service {
  id         Int             @id @default(autoincrement())
  name       String          @unique
  active     Boolean         @default(true)
  users      WorkerService[]
  tickets    Ticket[]
  rates      Rate[]
  operations Operation[]
}

model User {
  id           Int                @id @default(autoincrement())
  name         String
  username     String             @unique
  dni          String?            @unique
  passwordHash String
  role         UserRole
  active       Boolean            @default(true)
  availability WorkerAvailability @default(PAUSED)
  lastActiveAt DateTime?
  moduleNumber Int?
  branchId     Int?
  branch       Branch?            @relation(fields: [branchId], references: [id])
  services     WorkerService[]
  created      Ticket[]           @relation("TicketCreator")
  assigned     Ticket[]           @relation("TicketWorker")
  largeRooms   LargeRoom[]        @relation("LargeRoomAdvisor")
  history      TicketHistory[]    @relation("HistoryActor")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model WorkerService {
  userId    Int
  serviceId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

model Bank {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  active     Boolean     @default(true)
  rates      Rate[]
  operations Operation[]
}

model Rate {
  id        Int     @id @default(autoincrement())
  serviceId Int
  bankId    Int
  rate      Float
  service   Service @relation(fields: [serviceId], references: [id])
  bank      Bank    @relation(fields: [bankId], references: [id])

  @@unique([serviceId, bankId])
}

model Ticket {
  id             Int             @id @default(autoincrement())
  code           String
  dni            String
  documentType   String          @default("DNI")
  clientName     String
  district       String?
  isPreferential Boolean         @default(false)
  phone          String?
  notes          String?
  status         TicketStatus    @default(WAITING)
  branchId       Int
  serviceId      Int
  createdById    Int?
  assignedToId   Int?
  largeRoomId    Int?
  arrivedAt      DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  branch         Branch          @relation(fields: [branchId], references: [id])
  service        Service         @relation(fields: [serviceId], references: [id])
  createdBy      User?           @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo     User?           @relation("TicketWorker", fields: [assignedToId], references: [id])
  largeRoom      LargeRoom?      @relation(fields: [largeRoomId], references: [id], onDelete: SetNull)
  history        TicketHistory[]
  operations     Operation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId, status, arrivedAt])
  @@index([largeRoomId, status])
}

model LargeRoom {
  id        Int      @id @default(autoincrement())
  branchId  Int      @unique
  workerId  Int?
  active    Boolean  @default(false)
  capacity  Int      @default(10)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  worker    User?    @relation("LargeRoomAdvisor", fields: [workerId], references: [id], onDelete: SetNull)
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketHistory {
  id       Int          @id @default(autoincrement())
  ticketId Int
  status   TicketStatus
  actorId  Int?
  at       DateTime     @default(now())
  ticket   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor    User?        @relation("HistoryActor", fields: [actorId], references: [id])
}

model Operation {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  serviceId Int
  bankId    Int?
  commercialChannel String?
  amount    Float
  rate      Float
  profit    Float
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])
  bank      Bank?    @relation(fields: [bankId], references: [id])
}

model TicketPurgeArchive {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  branchCodes String
  ticketCount Int
  payload     Json     @db.JsonB
  sha256      String

  @@map("_TicketPurgeArchive")
}
